#!/bin/bash
# ╔════════════════════════════════════════════════════════════════╗
# ║                    VNC Connect Helper                          ║
# ╚════════════════════════════════════════════════════════════════╝
#
# Usage: vnc-connect [name]
#        vnc-connect          # Interactive selection with fzf
#        vnc-connect homelab  # Connect directly to 'homelab'
#        vnc-connect -l       # List all connections
#

CONFIG_FILE="${HOME}/.config/vnc/connections.conf"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check config exists
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}Error: Config file not found: $CONFIG_FILE${NC}"
    echo "Create it with entries like: name|host:port|description"
    exit 1
fi

# Parse connections (skip comments and empty lines)
get_connections() {
    grep -v '^#' "$CONFIG_FILE" | grep -v '^$' | grep '|'
}

# List all connections
list_connections() {
    echo -e "${CYAN}Available VNC Connections:${NC}"
    echo "───────────────────────────────────────────────────────"
    printf "  ${GREEN}%-15s${NC} %-25s %s\n" "NAME" "HOST" "DESCRIPTION"
    echo "───────────────────────────────────────────────────────"
    get_connections | while IFS='|' read -r name host desc; do
        printf "  %-15s %-25s %s\n" "$name" "$host" "$desc"
    done
    echo ""
}

# Connect to VNC
connect() {
    local name="$1"
    local host
    
    # Find the host for this name
    host=$(get_connections | grep "^${name}|" | cut -d'|' -f2)
    
    if [[ -z "$host" ]]; then
        echo -e "${RED}Error: Connection '$name' not found${NC}"
        list_connections
        exit 1
    fi
    
    echo -e "${GREEN}Connecting to ${name}${NC} (${host})..."
    
    # Try VNC Viewer first, fall back to macOS Screen Sharing
    if [[ -d "/Applications/VNC Viewer.app" ]]; then
        open "vnc://${host}"
    else
        # macOS built-in Screen Sharing
        open "vnc://${host}"
    fi
}

# Interactive selection with fzf
interactive_select() {
    if ! command -v fzf &>/dev/null; then
        echo -e "${YELLOW}fzf not installed. Listing connections instead:${NC}"
        list_connections
        echo "Usage: vnc-connect <name>"
        exit 0
    fi
    
    local selection
    selection=$(get_connections | \
        awk -F'|' '{printf "%-15s │ %-25s │ %s\n", $1, $2, $3}' | \
        fzf --header="Select VNC Connection (ESC to cancel)" \
            --prompt="Connect to: " \
            --height=40% \
            --reverse)
    
    if [[ -n "$selection" ]]; then
        local name
        name=$(echo "$selection" | awk '{print $1}')
        connect "$name"
    fi
}

# Main
case "${1:-}" in
    -l|--list|list)
        list_connections
        ;;
    -h|--help|help)
        echo "VNC Connect - Quick VNC connection manager"
        echo ""
        echo "Usage: vnc-connect [options] [name]"
        echo ""
        echo "Options:"
        echo "  -l, --list    List all configured connections"
        echo "  -h, --help    Show this help"
        echo ""
        echo "Examples:"
        echo "  vnc-connect           # Interactive selection (requires fzf)"
        echo "  vnc-connect homelab   # Connect to 'homelab'"
        echo "  vnc-connect -l        # List all connections"
        echo ""
        echo "Config: $CONFIG_FILE"
        ;;
    "")
        interactive_select
        ;;
    *)
        connect "$1"
        ;;
esac
