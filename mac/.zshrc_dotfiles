# ═══════════════════════════════════════════════════════════════════
# Useful Functions
# ═══════════════════════════════════════════════════════════════════

# Create directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract any archive
extract() {
    if [[ -f "$1" ]]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.tar.xz)    tar xJf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Find in history
hg() {
    fc -ln 0 | grep -i "$@"
}

# Quick HTTP server
serve() {
    local port="${1:-8000}"
    echo "Serving on http://localhost:$port"
    python3 -m http.server "$port"
}

# JSON pretty print
json() {
    if [[ -t 0 ]]; then
        cat "$@" | python3 -m json.tool
    else
        python3 -m json.tool
    fi
}

# Quick note
note() {
    local note_file=~/.notes
    if [[ $# -eq 0 ]]; then
        cat "$note_file" 2>/dev/null
    else
        echo "$(date '+%Y-%m-%d %H:%M'): $*" >> "$note_file"
        echo "Note saved."
    fi
}

# Weather
weather() {
    curl -s "wttr.in/${1:-}?format=3"
}

# Calculator
calc() {
    python3 -c "from math import *; print($*)"
}

# Find process
psg() {
    ps aux | grep -i "$1" | grep -v grep
}

# Kill by name
psk() {
    pkill -9 -if "$1"
}

# Port checker
ports() {
    lsof -i -P -n | grep LISTEN
}

# What's using a port?
port() {
    lsof -i ":$1"
}

# Open VS Code in current or specified directory
c() {
    if [[ $# -eq 0 ]]; then
        code .
    else
        code "$@"
    fi
}

# Git clone and cd
gcld() {
    git clone "$1" && cd "$(basename "$1" .git)"
}

# Backup file with timestamp
bak() {
    cp "$1" "$1.bak.$(date +%Y%m%d%H%M%S)"
}

# Diff two files side by side
sdiff() {
    diff -y --suppress-common-lines "$1" "$2"
}

# Quick timer
timer() {
    local secs="${1:-60}"
    echo "Timer: $secs seconds"
    sleep "$secs" && terminal-notifier -message "Timer done!" -title "⏰ Timer" 2>/dev/null || echo "Timer done!"
}

# ═══════════════════════════════════════════════════════════════════
# FZF Configuration (fuzzy finder magic)
# ═══════════════════════════════════════════════════════════════════

if command -v fzf &>/dev/null; then
    # FZF options
    export FZF_DEFAULT_OPTS="
        --height 60%
        --layout=reverse
        --border rounded
        --info=inline
        --margin=1
        --padding=1
        --preview-window=right:50%:wrap
        --bind='ctrl-/:toggle-preview'
        --bind='ctrl-a:select-all'
        --bind='ctrl-d:deselect-all'
        --bind='ctrl-y:execute-silent(echo {+} | pbcopy)'
        --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
        --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
        --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
    "

    # Use fd if available
    if command -v fd &>/dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi

    # Preview with bat
    if command -v bat &>/dev/null; then
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :500 {}'"
    fi

    # Load fzf keybindings
    eval "$(fzf --zsh 2>/dev/null)" || true

    # Custom fzf functions
    # fzf cd into directory
    fcd() {
        local dir
        dir=$(fd --type d --hidden --follow --exclude .git 2>/dev/null | fzf +m --preview 'eza --tree --level=1 --icons {}') && cd "$dir"
    }

    # fzf edit file
    fe() {
        local file
        file=$(fzf --preview 'bat --color=always --line-range :500 {}') && ${EDITOR:-vim} "$file"
    }

    # fzf git branch checkout
    fbr() {
        local branches branch
        branches=$(git branch --all | grep -v HEAD) &&
        branch=$(echo "$branches" | fzf -d $(( 2 + $(wc -l <<< "$branches") )) +m) &&
        git checkout $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
    }

    # fzf git log browser
    flog() {
        git log --graph --color=always --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" |
        fzf --ansi --no-sort --reverse --tiebreak=index \
            --preview 'echo {} | grep -o "[a-f0-9]\{7\}" | head -1 | xargs git show --color=always' \
            --bind "enter:execute(echo {} | grep -o '[a-f0-9]\{7\}' | head -1 | xargs git show --color=always | less -R)"
    }

    # fzf kill process
    fkill() {
        local pid
        pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')
        if [[ -n "$pid" ]]; then
            echo "$pid" | xargs kill -${1:-9}
        fi
    }

    # fzf git add
    fga() {
        git status -s | fzf --ansi -m --preview 'git diff --color=always {2}' | awk '{print $2}' | xargs -r git add
    }

    # fzf history
    fh() {
        eval $(fc -ln 0 | fzf +s --tac)
    }
fi

