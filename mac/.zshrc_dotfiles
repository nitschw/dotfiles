# ═══════════════════════════════════════════════════════════════════
# Completion System (tab completion on steroids)
# ═══════════════════════════════════════════════════════════════════

autoload -Uz compinit
# Rebuild completion cache once a day
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# Completion styling
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.zcompcache"

# Menu selection
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{cyan}── %d ──%f'
zstyle ':completion:*:messages' format '%F{purple}%d%f'
zstyle ':completion:*:warnings' format '%F{red}No matches for: %d%f'

# Case insensitive, partial-word, and substring completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# Colors in completion
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Process completion
zstyle ':completion:*:*:kill:*' menu yes select
zstyle ':completion:*:kill:*' force-list always
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'

# SSH/SCP completion
#zstyle ':completion:*:(ssh|scp|rsync):*' hosts ${(f)"$(grep -h '^Host ' ~/.ssh/config ~/.ssh/config.d/* 2>/dev/null | grep -v '\*' | awk '{print $2}')"}

# Directory stack completion
zstyle ':completion:*:directory-stack' list-colors '=(#b) #([0-9]#)*( *)==95=38;5;12'

