# Syntax highlighting (must be last!)
if [[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# ═══════════════════════════════════════════════════════════════════
# Final Touches
# ═══════════════════════════════════════════════════════════════════

# Disable "you have mail" message
unset MAILCHECK

# Clean up any failed completion
zstyle ':completion:*' completer _complete _ignored

# Welcome message (optional - remove if annoying)
if command -v fastfetch &>/dev/null && [[ -z "$VSCODE_INJECTION" ]]; then
    # Only show in interactive terminal, not in VS Code integrated terminal
    : # Uncomment below to show fastfetch on shell start
    # fastfetch --logo small
fi

# ═══════════════════════════════════════════════════════════════════
# VS Code Compatibility (must come after prompt setup)
# ═══════════════════════════════════════════════════════════════════

if [[ "$TERM_PROGRAM" == "vscode" ]]; then
    # Disable vim mode indicator (causes zle reset-prompt issues)
    function zle-keymap-select { }
    function zle-line-finish { }
    # Disable right prompt (dynamic content interferes with terminal reads)
    RPROMPT=''
fi

# ═══════════════════════════════════════════════════════════════════
# Local Overrides (not tracked by git)
# ═══════════════════════════════════════════════════════════════════

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
