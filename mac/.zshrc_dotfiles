# ═══════════════════════════════════════════════════════════════════
# Prompt (beautiful, fast, git-aware)
# ═══════════════════════════════════════════════════════════════════

autoload -Uz vcs_info
autoload -Uz add-zsh-hook

# Git info configuration
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' unstagedstr '%F{red}●%f'
zstyle ':vcs_info:*' stagedstr '%F{green}●%f'
zstyle ':vcs_info:git:*' formats '%F{magenta}(%b%f%u%c%F{magenta})%f'
zstyle ':vcs_info:git:*' actionformats '%F{magenta}(%b%f%u%c%F{magenta}|%F{red}%a%f%F{magenta})%f'

# Update vcs_info before each prompt
precmd_vcs_info() { vcs_info }
add-zsh-hook precmd precmd_vcs_info

# Enable prompt substitution
setopt PROMPT_SUBST

# Vim mode indicator
vim_ins_mode='%F{cyan}❯%f'
vim_cmd_mode='%F{green}❮%f'
vim_mode=$vim_ins_mode

function zle-keymap-select {
    vim_mode="${${KEYMAP/vicmd/${vim_cmd_mode}}/(main|viins)/${vim_ins_mode}}"
    zle reset-prompt
}
zle -N zle-keymap-select

function zle-line-finish {
    vim_mode=$vim_ins_mode
}
zle -N zle-line-finish

# The prompt
# Left: path (git info)
# Right: execution time, exit code
PROMPT='%F{blue}%~%f ${vcs_info_msg_0_}
${vim_mode} '

# Right prompt: last command time and exit status
RPROMPT='%(?.%F{green}✓%f.%F{red}✗ %?%f) %F{242}%*%f'

# ═══════════════════════════════════════════════════════════════════
# Command Execution Time
# ═══════════════════════════════════════════════════════════════════

# Track command execution time
preexec() {
    cmd_start_time=$EPOCHSECONDS
}

precmd_exec_time() {
    if [[ -n $cmd_start_time ]]; then
        local elapsed=$((EPOCHSECONDS - cmd_start_time))
        if [[ $elapsed -ge 5 ]]; then
            # Format time nicely
            if [[ $elapsed -ge 3600 ]]; then
                local hours=$((elapsed / 3600))
                local mins=$(((elapsed % 3600) / 60))
                local secs=$((elapsed % 60))
                RPROMPT="%F{yellow}${hours}h${mins}m${secs}s%f $RPROMPT"
            elif [[ $elapsed -ge 60 ]]; then
                local mins=$((elapsed / 60))
                local secs=$((elapsed % 60))
                RPROMPT="%F{yellow}${mins}m${secs}s%f $RPROMPT"
            else
                RPROMPT="%F{yellow}${elapsed}s%f $RPROMPT"
            fi
        fi
        unset cmd_start_time
    fi
}
add-zsh-hook precmd precmd_exec_time

